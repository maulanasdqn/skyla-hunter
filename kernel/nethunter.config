# NetHunter: mac80211 + зовнішні USB Wi-Fi адаптери (monitor mode + injection)
# Драйвери навмисно модулями: вбудовані конфліктують символами HTC з qca-wifi-host-cmn

CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_MINSTREL_HT=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MAC80211_STA_HASH_MAX_SIZE=0

CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m

CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2X00_LIB=m
CONFIG_RT2X00_LIB_USB=m
CONFIG_RT2X00_LIB_FIRMWARE=y
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTLWIFI=m
CONFIG_RTLWIFI_USB=m
CONFIG_RTL8192CU=m

CONFIG_USB_CONFIGFS_F_HID=y

# --- Bluetooth HID / NetHunter Bluetooth Arsenal (BadBT) ---
# BT core (BT/BREDR/LE/HS) and UHID are already =y in sweet's defconfig;
# the profiles + HCI transports below are what the stock config omits.
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# Virtual + UART HCI so BlueZ in the Kali chroot can attach an adapter
CONFIG_BT_HCIVHCI=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCSP=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_UHID=y

# --- Namespaces (needed for proot / bwrap / podman / container tooling) ---
# sweet's defconfig ships these off, which is why proot and user-namespace
# based tools cannot run on the stock NetHunter kernel.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
# IPC_NS depends on (SYSVIPC || POSIX_MQUEUE); sweet disables both, so turn
# SYSVIPC on as well or CONFIG_IPC_NS silently gets dropped.
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_NAMESPACES=y
CONFIG_CHECKPOINT_RESTORE=y

# --- cgroup controllers for podman / runc / crun ---
# pids: process-count limits (v1 + v2; appears in cgroup.controllers).
# device: cgroup v1/hybrid devices controller (v2 uses eBPF via CGROUP_BPF=y).
# Both are bools gated only by CONFIG_CGROUPS (=y), no extra deps.
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y

# --- podman: container creation + bridge networking ---
# POSIX_MQUEUE: crun mounts mqueue in every container (blocker without it).
# FHANDLE: open_by_handle_at, moby "generally necessary".
# BRIDGE_NETFILTER + xt addrtype: bridged container networking + MASQUERADE.
# VXLAN/MACVLAN: extra network modes.
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
