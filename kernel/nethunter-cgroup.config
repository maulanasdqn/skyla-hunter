# skyla-nethunter — container cgroup controllers for podman / runc / crun.
#
# Append these to the kernel's config fragment (arch/arm64/configs/vendor/
# nethunter.config) and rebuild, the same way USER_NS/PID_NS were added — see
# KERNEL-NATIVE.md. This is NOT a kernel version bump (4.14 is BSP-locked and
# pre-GKI); it only switches on two controllers in the SAME 4.14 build.
#
# Both are simple bools gated only by CONFIG_CGROUPS (already =y), so nothing
# else is pulled in. On the running kernel they are currently:
#   # CONFIG_CGROUP_PIDS is not set
#   # CONFIG_CGROUP_DEVICE is not set
#
# Notes:
#  - CGROUP_PIDS adds the `pids` controller in BOTH cgroup v1 and v2. After the
#    rebuild it should appear in /sys/fs/cgroup/cgroup.controllers.
#  - CGROUP_DEVICE is the cgroup *v1* devices controller (used by runc/crun in
#    v1/hybrid mode). Under pure cgroup v2, device access is enforced via eBPF
#    (CONFIG_CGROUP_BPF, already =y), so this is for v1/hybrid compatibility.
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
